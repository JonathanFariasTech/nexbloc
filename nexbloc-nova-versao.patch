diff --git a/css/style.css b/css/style.css
index a431b4c..05dd7c6 100644
--- a/css/style.css
+++ b/css/style.css
@@ -58,6 +58,8 @@ button { font-family: inherit; cursor: pointer; }
 .tower-link .tn-num { font-size: .68rem; color: var(--grafite); letter-spacing: .12em; }
 .tower-link:hover { color: #fff; background: rgba(0,93,186,.25); }
 .tower-link.active { color: var(--ciano-bloco); background: rgba(0,199,215,.10); box-shadow: inset 3px 0 0 var(--ciano-bloco); }
+.tower-link.bmc-link { margin-top: 10px; font-size: .74rem; color: rgba(255,255,255,.5); border-top: 1px dashed rgba(0,199,215,.25); border-radius: 0 0 8px 8px; padding-top: 12px; }
+.tower-link.bmc-link .tn-num { color: var(--ciano-bloco); letter-spacing: 0; }
 .tower-link.active .tn-num { color: var(--ciano-bloco); }
 
 /* ================================ DECK ================================== */
@@ -263,7 +265,47 @@ button { font-family: inherit; cursor: pointer; }
 .bar-cost i { background: linear-gradient(135deg, #0a2a5e, var(--azul-conexao)); }
 .fin-note { margin-top: 8px; font-size: .82rem; color: var(--grafite); line-height: 1.6; }
 
-/* ========================= SLIDE 6 · ENCERRAMENTO ======================= */
+/* ====================== SLIDE 6 · CANVAS DE NEGÓCIO ===================== */
+.bmc-grid {
+  display: grid; grid-template-columns: repeat(10, 1fr); grid-template-rows: repeat(4, auto);
+  gap: clamp(8px, 1vw, 14px); max-width: 1240px;
+}
+.bmc-cell {
+  background: var(--branco); border: 1px solid rgba(1,28,75,.10); border-radius: 14px;
+  padding: 14px 16px; box-shadow: 0 6px 22px rgba(1,28,75,.06);
+  transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .35s var(--ease);
+}
+.bmc-cell:hover { transform: translateY(-4px); box-shadow: 0 14px 34px rgba(1,28,75,.12); border-color: rgba(0,93,186,.35); }
+.bmc-cell h3 {
+  display: flex; align-items: center; gap: 8px;
+  font-family: var(--font-display); font-weight: 700; font-size: .72rem; letter-spacing: .04em;
+  text-transform: uppercase; color: var(--azul-nexbloc); margin-bottom: 8px; line-height: 1.25;
+}
+.bmc-cell h3 svg { flex: 0 0 16px; width: 16px; height: 16px; color: var(--ciano-bloco); }
+.bmc-cell ul { list-style: none; display: flex; flex-direction: column; gap: 5px; }
+.bmc-cell li { position: relative; padding-left: 12px; font-size: .74rem; line-height: 1.45; color: var(--grafite); }
+.bmc-cell li::before { content: ""; position: absolute; left: 0; top: .52em; width: 5px; height: 5px; border-radius: 2px; background: var(--ciano-bloco); }
+/* posicionamento explícito — grade clássica do Business Model Canvas (Osterwalder) */
+.bmc-parceiros     { grid-column: 1 / 3;  grid-row: 1 / 3; }
+.bmc-atividades    { grid-column: 3 / 5;  grid-row: 1 / 3; }
+.bmc-recursos      { grid-column: 5 / 7;  grid-row: 1 / 2; }
+.bmc-proposta      { grid-column: 5 / 7;  grid-row: 2 / 3; }
+.bmc-relacionamento{ grid-column: 7 / 9;  grid-row: 1 / 2; }
+.bmc-canais        { grid-column: 7 / 9;  grid-row: 2 / 3; }
+.bmc-segmentos     { grid-column: 9 / 11; grid-row: 1 / 3; }
+.bmc-receita       { grid-column: 3 / 7;  grid-row: 3 / 5; }
+.bmc-custos        { grid-column: 7 / 11; grid-row: 3 / 5; }
+/* selo central com o cubo da marca (não é um dos 9 blocos) */
+.bmc-center {
+  grid-column: 5 / 7; grid-row: 3 / 5; z-index: 1;
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
+  background: var(--azul-nexbloc); border-color: transparent; text-align: center;
+}
+.bmc-center svg { width: 44px; height: auto; filter: drop-shadow(0 4px 12px rgba(0,199,215,.4)); }
+.bmc-center p { font-family: var(--font-display); font-weight: 800; font-size: 1rem; color: #fff; margin-top: 6px; letter-spacing: -.01em; }
+.bmc-center span { font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ciano-bloco); }
+
+/* ========================= SLIDE 7 · ENCERRAMENTO ======================= */
 .slide-end { display: grid; place-items: center; text-align: center; }
 .end-inner { max-width: 720px; }
 blockquote { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.8rem, 3.6vw, 3rem); line-height: 1.2; }
@@ -300,6 +342,10 @@ blockquote em { font-style: normal; color: var(--ciano-bloco); }
 .hint.hide { opacity: 0; }
 
 /* ============================ RESPONSIVO ================================ */
+@media (max-width: 1240px) {
+  .bmc-grid { grid-template-columns: repeat(2, 1fr); grid-template-rows: none; }
+  .bmc-grid > div { grid-column: auto !important; grid-row: auto !important; min-height: 120px; }
+}
 @media (max-width: 1080px) {
   .kpis { grid-template-columns: repeat(3, 1fr); }
   .cols { grid-template-columns: 1fr; }
@@ -316,6 +362,7 @@ blockquote em { font-style: normal; color: var(--ciano-bloco); }
   .hud { left: 0; bottom: 84px; }
   .progress { left: 0; }
   .hint { display: none; }
+  .bmc-grid { grid-template-columns: 1fr; }
   .cover-grid { grid-template-columns: 1fr; }
   .cover-tower { display: none; }
   .kpis { grid-template-columns: repeat(2, 1fr); }
