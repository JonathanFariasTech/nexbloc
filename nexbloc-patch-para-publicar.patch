+/* painel do canvas ocupa a largura total do slide (não divide coluna com logo/equipe) */
+.bmc-panel { width: 100%; }
 .bmc-grid {
-  display: grid; grid-template-columns: repeat(10, 1fr); grid-template-rows: repeat(4, auto);
