--- a/css/style.css
+++ b/css/style.css
@@ -372,3 +372,73 @@ blockquote em { font-style: normal; color: var(--ciano-bloco); }
 @media (prefers-reduced-motion: reduce) {
   *, *::before, *::after { animation: none !important; transition-duration: .01ms !important; }
 }
+
+/* ============ SLIDE DE AGRADECIMENTOS (orientador) ============ */
+.slide-thanks .thanks-inner {
+  max-width: 860px;
+  margin: 0 auto;
+  padding: clamp(2rem, 5vh, 4rem) clamp(1.25rem, 4vw, 3rem);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  text-align: center;
+  gap: 1.4rem;
+}
+.slide-thanks h2 {
+  font-family: var(--font-display);
+  font-size: clamp(1.7rem, 3.6vw, 2.7rem);
+  font-weight: 700;
+  letter-spacing: -0.02em;
+  line-height: 1.15;
+}
+.slide-thanks .kicker { color: var(--ciano-bloco); }
+.mentor-card {
+  display: flex;
+  align-items: center;
+  gap: 1.5rem;
+  text-align: left;
+  background: rgba(255, 255, 255, 0.06);
+  border: 1px solid rgba(255, 255, 255, 0.14);
+  border-radius: 18px;
+  padding: 1.6rem 1.9rem;
+  backdrop-filter: blur(6px);
+  max-width: 680px;
+}
+.mentor-avatar {
+  flex: 0 0 auto;
+  width: 72px;
+  height: 72px;
+  border-radius: 50%;
+  overflow: hidden;
+  display: grid;
+  place-items: center;
+  background: linear-gradient(150deg, var(--azul-conexao, #005DBA), #0a3f7e);
+  box-shadow: 0 0 0 3px rgba(0, 199, 215, 0.45);
+}
+.mentor-info { display: flex; flex-direction: column; gap: 0.35rem; }
+.mentor-role {
+  font-size: 0.72rem;
+  font-weight: 600;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--ciano-bloco);
+}
+.mentor-name {
+  font-family: var(--font-display);
+  font-size: 1.25rem;
+  font-weight: 700;
+}
+.mentor-text {
+  font-size: 0.95rem;
+  line-height: 1.6;
+  color: rgba(255, 255, 255, 0.85);
+}
+.thanks-note {
+  font-size: 0.85rem;
+  letter-spacing: 0.04em;
+  color: rgba(255, 255, 255, 0.65);
+}
+@media (max-width: 640px) {
+  .mentor-card { flex-direction: column; text-align: center; padding: 1.4rem; }
+  .mentor-info { align-items: center; }
+}
