   border: 1px solid rgba(0,199,215,.4);
@@ -341,6 +344,20 @@ button { font-family: inherit; cursor: pointer; }
 .bmc-center p { font-family: var(--font-display); font-weight: 800; font-size: 1rem; color: #fff; margin-top: 6px; letter-spacing: -.01em; }
 .bmc-center span { font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ciano-bloco); }
 
+/* ---- barra de abas do slide Empresa (A empresa · Canvas de negócio) ---- */
+.tabbar { display: inline-flex; gap: 6px; padding: 6px; margin-bottom: clamp(16px, 2.6vh, 28px);
+  background: rgba(255,255,255,.55); border: 1px solid rgba(255,255,255,.85); border-radius: 14px;
+  backdrop-filter: blur(14px) saturate(1.5); -webkit-backdrop-filter: blur(14px) saturate(1.5);
+  box-shadow: 0 8px 28px rgba(1,28,75,.10), inset 0 1px 0 #fff; }
+.tab { appearance: none; border: 1px solid transparent; background: transparent; cursor: pointer;
+  font-family: var(--font-display); font-weight: 600; font-size: .82rem; color: var(--azul-conexao);
+  padding: 9px 18px; border-radius: 10px; letter-spacing: .01em;
+  transition: background .3s var(--ease), color .3s var(--ease), border-color .3s var(--ease), box-shadow .3s var(--ease); }
+.tab:hover { background: rgba(0,199,215,.10); }
+.tab.is-active { background: linear-gradient(135deg, var(--azul-nexbloc), var(--azul-conexao)); color: #fff;
+  border-color: rgba(0,199,215,.45); box-shadow: 0 6px 18px rgba(0,93,186,.35), inset 0 1px 0 rgba(255,255,255,.25); }
+.tab-panel[hidden] { display: none; }
+
 /* ========================= SLIDE 7 · ENCERRAMENTO ======================= */
 .slide-end { display: grid; place-items: center; text-align: center; }
 .end-inner { max-width: 720px; }
