 }
 .bmc-cell {
   background: linear-gradient(135deg, rgba(255,255,255,.78) 0%, rgba(238,244,250,.55) 45%, rgba(255,255,255,.68) 100%);
@@ -318,18 +321,18 @@ button { font-family: inherit; cursor: pointer; }
